DATABASE_URL=postgresql+psycopg://intellivault:intellivault@db:5432/intellivault
JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_MINUTES=60
REDIS_URL=redis://redis:6379/0
QUERY_CACHE_TTL_SECONDS=300
EMBEDDING_CACHE_TTL_SECONDS=3600
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=http://localhost:5173
GENERATION_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434
GENERATION_TIMEOUT_SECONDS=120
GENERATION_TEMPERATURE=0.2
GENERATION_CONTEXT_WINDOW=8192
OLLAMA_KEEP_ALIVE=10m
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Production hardening
ENVIRONMENT=production
TRUSTED_HOSTS=api.example.com
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=500
MAX_CHUNKS_PER_DOCUMENT=10000
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
EXPOSE_DOCS=false
EXPOSE_METRICS=false

# Malware scanning
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=60
CLAMAV_CHUNK_BYTES=65536
CLAMAV_FAIL_CLOSED=true

# S3-compatible object storage
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=replace
S3_SECRET_ACCESS_KEY=replace
S3_REGION=auto
S3_BUCKET=intellivault
S3_ADDRESSING_STYLE=virtual
S3_PREFIX=documents
